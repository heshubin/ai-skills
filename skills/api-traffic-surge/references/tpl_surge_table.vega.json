{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "指定接口的最近完整半小时突增判定；直接读取ES聚合。",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": 12,
  "config": {
    "kibana": {
      "restoreSignalValuesOnRefresh": true
    }
  },
  "signals": [
    {
      "name": "ready",
      "update": "length(data('response')) > 0 && !data('response')[0].timed_out && data('response')[0]._shards.failed == 0"
    },
    {
      "name": "target",
      "update": "ready ? floor(data('response')[0].aggregations.all.buckets[0].clock.buckets[0].from / 1800000) * 1800000 - 1800000 : 0"
    },
    {
      "name": "targetDay",
      "update": "floor((target+tzOffset)/86400000)*86400000-tzOffset"
    },
    {
      "name": "tzOffset",
      "value": "${timezone_offset_ms}"
    },
    {
      "name": "surgeK",
      "value": "${surge_k}"
    },
    {
      "name": "peakRatio",
      "value": "${peak_ratio}"
    },
    {
      "name": "minCount",
      "value": "${surge_min_count}"
    }
  ],
  "data": [
    {
      "name": "response",
      "url": {
        "index": "${index_patterns}",
        "body": {}
      }
    },
    {
      "name": "api",
      "values": [],
      "transform": [
        {
          "type": "formula",
          "expr": "ready ? data('response')[0].aggregations.all.buckets[0].apis.buckets[datum.name].slots.buckets : []",
          "as": "slots"
        }
      ]
    },
    {
      "name": "series",
      "source": "api",
      "transform": [
        {
          "type": "flatten",
          "fields": [
            "slots"
          ],
          "as": [
            "slot"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.slot.key",
          "as": "time"
        },
        {
          "type": "formula",
          "expr": "datum.slot.doc_count",
          "as": "calls"
        }
      ]
    },
    {
      "name": "baseline",
      "source": "series",
      "transform": [
        {
          "type": "formula",
          "expr": "(target-datum.time)/86400000",
          "as": "daysAgo"
        },
        {
          "type": "filter",
          "expr": "datum.daysAgo>=1 && datum.daysAgo<=7 && datum.daysAgo==floor(datum.daysAgo)"
        },
        {
          "type": "aggregate",
          "groupby": [
            "name"
          ],
          "fields": [
            null,
            "calls",
            "calls",
            "calls"
          ],
          "ops": [
            "count",
            "mean",
            "variancep",
            "max"
          ],
          "as": [
            "n",
            "mean",
            "variance",
            "peak"
          ]
        },
        {
          "type": "formula",
          "expr": "sqrt(datum.variance)",
          "as": "sigma"
        }
      ]
    },
    {
      "name": "previous",
      "source": "series",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.time==target-1800000"
        }
      ]
    },
    {
      "name": "weekly",
      "source": "series",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.time==target-7*86400000"
        }
      ]
    },
    {
      "name": "coverage",
      "values": [],
      "transform": [
        {
          "type": "formula",
          "expr": "ready ? data('response')[0].aggregations.all.buckets[0].coverage.buckets[datum.service].days.buckets : []",
          "as": "days"
        },
        {
          "type": "flatten",
          "fields": [
            "days"
          ],
          "as": [
            "day"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.day.key>=targetDay-7*86400000 && datum.day.key<targetDay"
        },
        {
          "type": "formula",
          "expr": "datum.day.doc_count>0 ? 1 : 0",
          "as": "present"
        },
        {
          "type": "aggregate",
          "groupby": [
            "service"
          ],
          "fields": [
            "present"
          ],
          "ops": [
            "sum"
          ],
          "as": [
            "covered_days"
          ]
        }
      ]
    },
    {
      "name": "current",
      "source": "series",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.time==target"
        },
        {
          "type": "lookup",
          "from": "baseline",
          "key": "name",
          "fields": [
            "name"
          ],
          "as": [
            "base"
          ]
        },
        {
          "type": "lookup",
          "from": "previous",
          "key": "name",
          "fields": [
            "name"
          ],
          "as": [
            "prior"
          ]
        },
        {
          "type": "lookup",
          "from": "weekly",
          "key": "name",
          "fields": [
            "name"
          ],
          "as": [
            "week"
          ]
        },
        {
          "type": "lookup",
          "from": "coverage",
          "key": "service",
          "fields": [
            "service"
          ],
          "as": [
            "coverage"
          ]
        },
        {
          "type": "formula",
          "expr": "datum.base && datum.base.n==7 && datum.coverage && datum.coverage.covered_days==7",
          "as": "complete"
        },
        {
          "type": "formula",
          "expr": "datum.base ? datum.base.mean+surgeK*datum.base.sigma : 0",
          "as": "statThreshold"
        },
        {
          "type": "formula",
          "expr": "datum.base ? datum.base.peak*peakRatio : 0",
          "as": "peakThreshold"
        },
        {
          "type": "formula",
          "expr": "datum.complete && datum.calls>=minCount && (datum.base.peak==0 || (datum.calls>datum.statThreshold && datum.calls>datum.peakThreshold))",
          "as": "surge"
        },
        {
          "type": "formula",
          "expr": "!datum.complete ? '基线不足' : datum.surge ? '突增' : datum.calls==0 ? '零调用' : '正常'",
          "as": "status"
        },
        {
          "type": "formula",
          "expr": "!datum.complete ? '#a16207' : datum.surge ? '#bd271e' : datum.calls==0 ? '#69707d' : '#167759'",
          "as": "statusColor"
        },
        {
          "type": "formula",
          "expr": "datum.prior && datum.prior.calls>0 ? format((datum.calls/datum.prior.calls-1)*100,'+.1f')+'%' : datum.calls==0 ? '—' : '新增'",
          "as": "mom"
        },
        {
          "type": "formula",
          "expr": "datum.week && datum.week.calls>0 ? format((datum.calls/datum.week.calls-1)*100,'+.1f')+'%' : datum.calls==0 ? '—' : '新增'",
          "as": "wow"
        },
        {
          "type": "formula",
          "expr": "datum.surge ? 1 : 0",
          "as": "surgeN"
        },
        {
          "type": "formula",
          "expr": "datum.calls>0 ? 1 : 0",
          "as": "activeN"
        },
        {
          "type": "formula",
          "expr": "datum.complete ? 0 : 1",
          "as": "missingN"
        },
        {
          "type": "collect",
          "sort": {
            "field": [
              "surgeN",
              "ordinal"
            ],
            "order": [
              "descending",
              "ascending"
            ]
          }
        },
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "row"
          ]
        }
      ]
    },
    {
      "name": "summary",
      "source": "current",
      "transform": [
        {
          "type": "aggregate",
          "fields": [
            "calls",
            "surgeN",
            "activeN",
            "missingN"
          ],
          "ops": [
            "sum",
            "sum",
            "sum",
            "sum"
          ],
          "as": [
            "total",
            "surges",
            "active",
            "missing"
          ]
        }
      ]
    }
  ],
