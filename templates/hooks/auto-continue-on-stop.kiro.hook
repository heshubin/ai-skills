{
  "enabled": false,
  "name": "自动继续执行",
  "description": "【已禁用，勿轻易开启】当 agent 回复被截断时自动发送继续指令。风险：agentStop 无法区分「被截断」与「正常完成」，开启后每轮正常结束都会被要求继续，可能导致 agent 凭空继续操作或自我循环消耗额度。需要续跑时手动输入「继续」即可。",
  "version": "1.0.0",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "askAgent",
    "prompt": "若你上一次回复确实在中途被截断（存在未写完的句子、未闭合的代码块、或明确未完成的待办步骤），从中断处继续，不要重复已完成内容。若上一次回复是完整收尾的，立即结束，不要输出任何文字。"
  }
}
